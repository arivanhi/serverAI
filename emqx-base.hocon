authentication = [
  {
    backend = "built_in_database"
    mechanism = "password_based"
    password_hash_algorithm {
      name = "sha256"
      salt_position = "suffix"
    }
    user_id_type = "username"
    bootstrap_file = "${EMQX_ETC_DIR}/auth-built-in-db-bootstrap.csv"
    bootstrap_type = "plain"
  }
]

authorization {
  no_match = deny
  deny_action = ignore
  cache.enable = true
}
